# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ${NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_REDIRECT_URI=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# For signing host session cookies + OAuth state (any long random string)
SESSION_SECRET=
