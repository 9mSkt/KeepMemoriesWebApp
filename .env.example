# Copy to .env.local and fill in. Never commit .env.local.
# Optional: your site address, e.g. https://keep-memories.vercel.app (derived from the request if empty)
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ${APP_URL}/api/google/callback (derived from APP_URL / the request if empty)
GOOGLE_REDIRECT_URI=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# For signing host session cookies + OAuth state (any long random string)
SESSION_SECRET=
